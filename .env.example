# API
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp
DB_PASSWORD=erp
DB_NAME=erp

# Autenticação
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Validade do token, em segundos (8h)
JWT_EXPIRES_IN=28800

# Fuso usado para a data de "hoje" (padrão das baixas, movimentações e relatórios)
APP_TIMEZONE=America/Sao_Paulo

# Segurança
# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula (vazio: nenhuma)
CORS_ORIGENS=
# Atrás de proxy reverso (nginx, load balancer): número de proxies na frente da API
TRUST_PROXY=
# Requisições por minuto por IP: geral e em login/cadastro
THROTTLE_LIMITE=300
THROTTLE_LOGIN_LIMITE=10
# Documentação em /docs; em produção (NODE_ENV=production) fica desligada, a menos que seja true
SWAGGER_HABILITADO=
