# API
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp
DB_PASSWORD=erp
DB_NAME=erp

# Autenticação
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Validade do token, em segundos (8h)
JWT_EXPIRES_IN=28800

# NFS-e: chave que cifra o certificado digital A1 guardado no banco (64 caracteres hexadecimais).
# Gere com: openssl rand -hex 32. Se trocar, instale o certificado de novo.
CHAVE_CERTIFICADOS=

# Endereços da API do Emissor Nacional; vazios usam os oficiais (só mude se o governo mudar)
NFSE_URL_PRODUCAO=
NFSE_URL_HOMOLOGACAO=

# Contratos recorrentes: de quantos em quantos minutos o agendador gera as cobranças do mês (0 desliga)
CONTRATOS_AGENDADOR_MINUTOS=60

# Fuso usado para a data de "hoje" (padrão das baixas, movimentações e relatórios)
APP_TIMEZONE=America/Sao_Paulo

# Segurança
# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula (vazio: nenhuma)
CORS_ORIGENS=
# Atrás de proxy reverso (nginx, load balancer): número de proxies na frente da API
TRUST_PROXY=
# Requisições por minuto por IP: geral e em login/cadastro
THROTTLE_LIMITE=300
THROTTLE_LOGIN_LIMITE=10
# Consultas de CNPJ por minuto por IP (fontes gratuitas da Receita)
THROTTLE_CNPJ_LIMITE=30
# Consultas de CEP por minuto por IP (ViaCEP e BrasilAPI)
THROTTLE_CEP_LIMITE=60
# Documentação em /docs; em produção (NODE_ENV=production) fica desligada, a menos que seja true
SWAGGER_HABILITADO=
# Cookie de sessão só por HTTPS (padrão: true quando NODE_ENV=production)
COOKIE_SECURE=
